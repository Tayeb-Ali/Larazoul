@php
    $isEdit = isset($DummyVariable) && $DummyVariable?->exists;
    $action = $isEdit
        ? route('admin.DummyPluralVariable.update', $DummyVariable)
        : route('admin.DummyPluralVariable.store');
    $method = $isEdit ? 'PUT' : 'POST';
@endphp

<form action="{{ $action }}" method="POST" class="max-w-2xl bg-white rounded-lg shadow p-6 space-y-4">
    @csrf
    @method($method)


{
    "name": "tayeb-ali/larazoul",
    "version": "4.0.0",
    "description": "LaraZoul - A modern Laravel CMS and CRUD module generator rebuilt for Laravel 13 (Blade + Tailwind + Livewire).",
    "keywords": ["laravel", "cms", "crud", "generator", "admin", "livewire", "tailwind"],
    "license": "MIT",
    "authors": [
        {
            "name": "Elteyab Hassan",
            "email": "me@elteyab.sd"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Larazoul\\Larazoul\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larazoul\\Larazoul\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larazoul\\Larazoul\\LarazoulServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
